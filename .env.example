# --- GOOGLE OAUTH 2.0 ---
# Obtené tu Client ID desde https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_cliente_id_aqui.apps.googleusercontent.com

# --- SEGURIDAD JWT ---
# Clave secreta para firmar los tokens de sesión (podés usar cualquier cadena larga y segura)
JWT_SECRET=super-secreto-cambiar-en-produccion-123456789

# --- BASE DE DATOS EN LA NUBE (OPCIONAL) ---
# Si no se define, se usa SQLite local ("watchlists.db").
# Si usás PostgreSQL en Neon.tech, Supabase o Render, descomentá y pegá tu URL:
# DATABASE_URL=postgresql://usuario:password@ep-ejemplo.neon.tech/neondb?sslmode=require
